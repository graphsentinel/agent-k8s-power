# Pinned versions for a reproducible lab. Sourced by scripts/platform.sh and scripts/lab.sh.
# Change a value here, not in the scripts. scripts/check-versions.sh lists newer upstream releases.
# Last refreshed: 2026-10-11 (latest stable of each at that date). Docker and python3 come from Ubuntu's packages.

# Host tools not packaged by Ubuntu, installed by scripts/platform.sh only when missing
K3D_VERSION=v5.9.0
KUBECTL_VERSION=v1.37.1

# Cluster: k3d runs each k3s node as a container (1 server + 1 agent). The server's kube-apiserver uses the lab's
# structured authentication / authorization / audit configuration (lab/k3s), so the cluster is part of the lab.
CLUSTER=s1-agent-power
K3S_IMAGE=docker.io/rancher/k3s:v1.37.1-k3s1

# Runtime images (pulled, then imported into k3d; the manifests in lab/k8s use the same references)
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0
PYTHON_IMAGE=docker.io/library/python:3.14.8-slim-trixie
